#!/bin/sh
# Commit messages name the people who wrote the change, never an AI assistant.
# Installed by `pnpm install` (the root `prepare` script points core.hooksPath here).
if grep -qiE '^co-authored-by:.*(claude|anthropic)|generated with .*claude' "$1"; then
  echo "commit-msg: drop the Claude attribution line from the commit message." >&2
  exit 1
fi
