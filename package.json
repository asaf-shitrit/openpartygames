{
  "name": "openpartygames",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @opg/web --filter @opg/worker dev",
    "build": "pnpm --filter @opg/web build",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives",
    "lint:fix": "oxlint --type-aware --fix",
    "typecheck": "pnpm -r --no-bail typecheck",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "crap": "node scripts/clean-coverage.mjs && crap-typescript --format text --failures-only --threshold 8",
    "validate:packs": "node scripts/validate-packs.mjs",
    "check": "pnpm validate:packs && pnpm lint && pnpm typecheck && pnpm test && pnpm crap && pnpm build",
    "e2e:setup": "node scripts/e2e-setup.mjs",
    "e2e:api": "vitest run --config e2e/api/vitest.config.ts",
    "e2e:browser": "playwright test -c e2e/browser/playwright.config.ts",
    "e2e": "pnpm e2e:api && pnpm e2e:browser"
  },
  "devDependencies": {
    "@barney-media/crap-typescript": "0.5.2",
    "@oxlint/plugins": "1.83.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "5.0.0",
    "happy-dom": "20.14.5",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "ws": "^8.21.3"
  }
}
