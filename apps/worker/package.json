{
  "name": "@opg/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mkdir -p ../web/dist && wrangler dev",
    "deploy": "pnpm --filter @opg/web build && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc -p tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply openpartygames --local",
    "db:seed:local": "node ../../scripts/build-pack-seed.mjs && wrangler d1 execute openpartygames --local --file=.wrangler/pack-seed.sql"
  },
  "dependencies": {
    "@opg/game-imposter": "workspace:*",
    "@opg/game-most-likely-to": "workspace:*",
    "@opg/game-real-or-nah": "workspace:*",
    "@opg/protocol": "workspace:*",
    "@opg/sdk": "workspace:*"
  },
  "devDependencies": {
    "wrangler": "^4.131.2"
  }
}
